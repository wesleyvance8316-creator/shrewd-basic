#ifndef SHREWD_BASIC_CONFIG_H
#define SHREWD_BASIC_CONFIG_H

/**
 * @file config.h
 * @brief Compile-time configuration options generated by CMake. Do not edit.
 *
 * Option values come from the CMake cache; see cmake/ConfigHeader.cmake.
 */

/** Set to 1 to enable internal consistency checks, 0 to disable. */
#cmakedefine01 SHREWD_BASIC_ENABLE_ASSERTS

/** Log verbosity: 0 = off, 1 = error, 2 = warning, 3 = info, 4 = debug. */
#define SHREWD_BASIC_LOG_LEVEL @SHREWD_BASIC_LOG_LEVEL@

#endif /* SHREWD_BASIC_CONFIG_H */
