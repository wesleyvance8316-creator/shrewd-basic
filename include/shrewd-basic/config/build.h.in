#ifndef SHREWD_BASIC_BUILD_H
#define SHREWD_BASIC_BUILD_H

/**
 * @file build.h
 * @brief Build information generated by CMake at configure time. Do not edit.
 */

#include <stdint.h>

/** Build timestamp as Unix epoch seconds. */
#define SHREWD_BASIC_BUILD_TIME INT64_C(@BUILD_EPOCH@)

/** Library version, e.g. "v0.1.0 2026-10-30 23:15:00". */
#define SHREWD_BASIC_VERSION_STRING "@BUILD_VERSION_STRING@"

/** Build host and toolchain, e.g. "Linux x86_64 ubuntu.pve / GNU 15.2.0". */
#define SHREWD_BASIC_BUILD_ENV "@BUILD_ENV_STRING@"

#endif /* SHREWD_BASIC_BUILD_H */
