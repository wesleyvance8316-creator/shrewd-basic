#ifndef SHREWD_BASIC_BUILD_H
#define SHREWD_BASIC_BUILD_H

/**
 * @file build.h
 * @brief Build information generated by CMake at configure time. Do not edit.
 *
 * The macros below carry the stamped values; the static inline accessors
 * are the build-info API (no library linkage needed - each translation
 * unit compiles its own copy).
 */

#include <stddef.h>
#include <stdint.h>

#include "shrewd-basic/platform/error.h"

/** Build timestamp as Unix epoch seconds. */
#define SHREWD_BASIC_BUILD_TIME INT64_C(@BUILD_EPOCH@)

/** Library version, e.g. "v0.1.0 2026-10-30 23:15:00". */
#define SHREWD_BASIC_VERSION_STRING "@BUILD_VERSION_STRING@"

/** Build host and toolchain, e.g. "Linux x86_64 ubuntu.pve / GNU 15.2.0". */
#define SHREWD_BASIC_BUILD_ENV "@BUILD_ENV_STRING@"

/** Version components taken verbatim from project(). */
#define SHREWD_BASIC_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define SHREWD_BASIC_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define SHREWD_BASIC_VERSION_PATCH @PROJECT_VERSION_PATCH@

/**
 * Store the full version string, e.g. "v0.1.0 2026-10-30 23:15:00",
 * into @p *out. Returns SHREWD_BASIC_ERR_OK or
 * SHREWD_BASIC_ERR_ARG_INVALID.
 */
static inline int shrewd_basic_version(const char **out)
{
    if (NULL == out) {
        return SHREWD_BASIC_ERR_ARG_INVALID;
    }
    *out = SHREWD_BASIC_VERSION_STRING;
    return SHREWD_BASIC_ERR_OK;
}

/** The full version string (same value shrewd_basic_version() stores). */
static inline const char *shrewd_basic_version_string(void)
{
    return SHREWD_BASIC_VERSION_STRING;
}

/**
 * Version components of project(), e.g. (0, 1, 0). Any output pointer
 * may be NULL to skip that component. Returns SHREWD_BASIC_ERR_OK.
 */
static inline int shrewd_basic_version_parts(int *major, int *minor,
                                             int *patch)
{
    if (NULL != major) {
        *major = SHREWD_BASIC_VERSION_MAJOR;
    }
    if (NULL != minor) {
        *minor = SHREWD_BASIC_VERSION_MINOR;
    }
    if (NULL != patch) {
        *patch = SHREWD_BASIC_VERSION_PATCH;
    }
    return SHREWD_BASIC_ERR_OK;
}

/** Build timestamp as Unix epoch seconds (same as SHREWD_BASIC_BUILD_TIME). */
static inline int64_t shrewd_basic_build_time(void)
{
    return SHREWD_BASIC_BUILD_TIME;
}

/** Build host and toolchain description (same as SHREWD_BASIC_BUILD_ENV). */
static inline const char *shrewd_basic_build_env(void)
{
    return SHREWD_BASIC_BUILD_ENV;
}

/**
 * Return @p value clamped into the inclusive range [@p low, @p high].
 * If the range is empty (@p low > @p high), @p low is returned.
 */
static inline int shrewd_basic_clamp(int value, int low, int high)
{
    if (low > high) {
        return low;
    }
    if (value < low) {
        return low;
    }
    return (value > high) ? high : value;
}

#endif /* SHREWD_BASIC_BUILD_H */
